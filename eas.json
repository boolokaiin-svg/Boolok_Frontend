        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "930993891303-9tadsr1d3kle9b11mfsp28q286mpsde6.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
